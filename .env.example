# Copy to .env and edit. Never commit .env (only this example is tracked).
# Running several stacks on one host: give each its own COMPOSE_PROJECT_NAME and host ports.

COMPOSE_PROJECT_NAME=hmis
HMIS_HOSTNAME=hmis.local
HMIS_VERSION=dev
LOG_LEVEL=info

# Host ports
WEB_PORT=3000
PG_PORT=55432
CADDY_HTTPS_PORT=443
CADDY_HTTP_PORT=80

# Postgres. Use a long random password on real servers (install.sh will generate one).
PG_IMAGE=postgres:17
POSTGRES_USER=hmis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hmis

# App login role (member of hmis_app: no DELETE, append-only audit/access logs). `pnpm db:migrate`
# creates/updates it; web connects with it. Empty = web uses the POSTGRES_USER owner (dev only).
APP_DB_USER=hmis_app_login
APP_DB_PASSWORD=

# Encrypts secrets at rest (TOTP seeds for owner/admin remote access). At least 32 random
# characters, e.g. `openssl rand -hex 32`; install.sh generates one. Changing it disables TOTP
# for everyone (they re-enrol). Empty = phone codes cannot be set up.
HMIS_SECRET_KEY=

# First run of `pnpm db:seed`: facility name and initial admin (password printed once if empty;
# a new password is required at first sign-in).
HMIS_FACILITY_NAME=Hospital
HMIS_ADMIN_USERNAME=admin
HMIS_ADMIN_PASSWORD=

# Optional: overrides POSTGRES_* + PG_PORT for host-side tools (pnpm dev / db:*).
# DATABASE_URL=postgres://hmis:change-me@127.0.0.1:55432/hmis

# WhatsApp (MSG-01, Meta Cloud API). Empty = messages stay queued. Pick the provider with the
# `whatsapp.provider` setting. Read by the worker only.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Backups (OPS-01, docs/31 §3). Read by the `backup` container. ----------------------------
# Encrypts all restic repositories (local, USB, S3). install.sh generates it; keep a copy OFFLINE
# (owner's safe): without it no backup can be restored.
BACKUP_PASSPHRASE=change-me-backup-passphrase
BACKUP_AT=02:00
BACKUP_DB_EVERY_MIN=60
# 1 = also back up to the rotating USB disk mounted at BACKUP_USB_HOST_DIR (prepare with
# infra/scripts/usb-init.sh).
BACKUP_USB_ENABLED=0
BACKUP_USB_HOST_DIR=/mnt/hmis-usb
# Offsite copy to an S3-compatible bucket (Mumbai: ap-south-1). Empty = off. Use a key limited to
# this bucket.
BACKUP_S3_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ---- Monitoring (OPS-01, docs/31 §5). Read by web (/api/health) and worker (ops.* jobs). -------
# healthchecks.io-style ping URL, hit every 5 minutes (and /fail while a critical alert is open).
HEALTHCHECK_PING_URL=
# Random ID (8-64 letters, digits, - or _) sent in the heartbeat instead of the hospital name.
HMIS_INSTALL_ID=
# Vendor alerts: a generic JSON webhook and/or a Telegram bot. Empty = alerts only in the logs.
OPS_ALERT_WEBHOOK_URL=
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
OPS_ALERT_LABEL=
OPS_ALERT_REPEAT_HOURS=6
# Thresholds (defaults are the docs/31 numbers).
OPS_BACKUP_MAX_AGE_HOURS=24
OPS_FILES_MAX_AGE_HOURS=36
OPS_CLOUD_MAX_LAG_HOURS=48
OPS_USB_ROTATION_DAYS=8
OPS_DISK_WARN_USED_PCT=80
OPS_DISK_CRITICAL_USED_PCT=90
OPS_QUEUE_BACKLOG_MAX=500

# Release images (update.sh): registry prefix, e.g. registry.example.com/hmis
HMIS_IMAGE_PREFIX=hmis

# TLS with Caddy's internal CA (docs/01 §9). Install the root certificate on every client PC:
#   docker compose ... exec caddy cat /data/caddy/pki/authorities/local/root.crt
{
	admin off
}

{$HMIS_HOSTNAME:hmis.local}, localhost {
	tls internal
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Client IP for remote-access detection (owner/admin TOTP, docs/01 §5): overwrite whatever
	# the client sent, so the web app can trust X-Forwarded-For.
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

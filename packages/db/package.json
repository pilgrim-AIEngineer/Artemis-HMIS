    "db:templates": "tsx seed/templates/generate.ts"
  },
  "dependencies": {
    "@hmis/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "exceljs": "^4.4.0",
    "testcontainers": "12.2.1"
  }
}

{
  "name": "@hmis/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./migrate": "./src/migrate.ts",
    "./schema": "./schema/index.ts",
    "./testing": "./testing/postgres.ts",
    "./testing/platform": "./testing/platform.ts",
    "./seed": "./seed/masters.ts",
    "./seed/demo": "./seed/demo/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
